{
  "id": "/",
  "name": "PlumiRecord",
  "short_name": "PlumiRecord",
  "description": "Turns an animated Claude Design slide into a social mp4",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
